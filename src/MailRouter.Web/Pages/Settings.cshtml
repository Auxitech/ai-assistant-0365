@page
@model SettingsModel
@using MailRouter.Web.Services
@{
    ViewData["Title"] = "Settings";
}
<h2>Settings</h2>

<div class="card my-3" style="max-width:860px">
    <div class="card-header">Microsoft 365 account</div>
    <div class="card-body">
        @if (!Model.GraphConfigured)
        {
            <div class="alert alert-warning mb-0">Graph is not configured. Set <code>GRAPH__CLIENTID</code> and <code>GRAPH__TENANTID</code> in the container environment (see README).</div>
        }
        else if (Model.Account != null)
        {
            <p class="mb-2">Connected as <strong>@Model.Account</strong></p>
            <form method="post" asp-page-handler="Disconnect"><button class="btn btn-sm btn-outline-danger">Disconnect</button></form>
        }
        else if (Model.PendingLogin != null)
        {
            <p>Open <a href="@Model.PendingLogin.VerificationUrl" target="_blank">@Model.PendingLogin.VerificationUrl</a> and enter this code:</p>
            <p class="display-6 font-monospace">@Model.PendingLogin.UserCode</p>
            <p class="text-muted small">Sign in with the mailbox the assistant should manage. This page refreshes automatically.</p>
            <script>setTimeout(() => location.reload(), 4000);</script>
        }
        else
        {
            @if (Model.LoginError != null) { <div class="alert alert-danger">@Model.LoginError</div> }
            <p>Not connected.</p>
            <form method="post" asp-page-handler="Connect"><button class="btn btn-primary">Connect Microsoft 365</button></form>
        }
        <div class="mt-3 small text-muted">AI (Claude): @(Model.AiEnabled ? "enabled" : "disabled — set ANTHROPIC_API_KEY")</div>
    </div>
</div>

<div class="card my-3" style="max-width:860px">
    <div class="card-header">Try the AI triage</div>
    <div class="card-body">
        <form method="post" asp-page-handler="TryAi" class="row g-2">
            <div class="col-md-6"><input asp-for="TrySender" class="form-control" placeholder="sender@cdb1.ch" /></div>
            <div class="col-md-6"><input asp-for="TrySubject" class="form-control" placeholder="Subject" /></div>
            <div class="col-12"><textarea asp-for="TryBody" class="form-control" rows="4" placeholder="Paste a message to see how it would be classified. Nothing is sent."></textarea></div>
            <div class="col-12"><button class="btn btn-outline-primary">Classify</button></div>
        </form>
        @if (Model.TryError != null)
        {
            <div class="alert alert-warning mt-3 mb-0">@Model.TryError</div>
        }
        @if (Model.TryResult is { } v)
        {
            var outcome = v.IsSensitive
                ? "🔒 Sensitive → not forwarded, no reply, stays unread in your inbox."
                : v.IsSupportRequest ? "🛟 Help request → the matching rule applies (forward/reply)."
                : "💬 Not a help request → skipped on rules with \"Only act on real help requests\".";
            <div class="alert @(v.IsSensitive ? "alert-warning" : v.IsSupportRequest ? "alert-success" : "alert-secondary") mt-3 mb-0">
                <div><strong>@outcome</strong></div>
                <div class="small mt-1">
                    Category: <code>@v.Category</code> · confidence @v.Confidence.ToString("P0") · language @v.Language<br />
                    Summary: @v.Summary
                    @if (v.IsSensitive && !string.IsNullOrWhiteSpace(v.SensitiveReason)) { <br /><span>Why sensitive: @v.SensitiveReason</span> }
                </div>
            </div>
        }
    </div>
</div>

<form method="post" asp-page-handler="Save" style="max-width:860px">
    <div class="card">
        <div class="card-header">Behaviour</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input asp-for="Input.Enabled" class="form-check-input" />
                    <label asp-for="Input.Enabled" class="form-check-label">Background processing enabled</label>
                </div>
                <div class="form-check form-switch mt-2">
                    <input asp-for="Input.DryRun" class="form-check-input" />
                    <label asp-for="Input.DryRun" class="form-check-label"><strong>Dry-run</strong> (log only, send nothing)</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check"><input asp-for="Input.ProcessEmail" class="form-check-input" /><label asp-for="Input.ProcessEmail" class="form-check-label">Process email (Inbox)</label></div>
                <div class="form-check"><input asp-for="Input.ProcessTeams" class="form-check-input" /><label asp-for="Input.ProcessTeams" class="form-check-label">Process Teams chats</label></div>
                <div class="form-check"><input asp-for="Input.TeamsOneOnOneOnly" class="form-check-input" /><label asp-for="Input.TeamsOneOnOneOnly" class="form-check-label">Teams: 1:1 chats only</label></div>
                <div class="form-check mt-2"><input asp-for="Input.MarkEmailAsRead" class="form-check-input" /><label asp-for="Input.MarkEmailAsRead" class="form-check-label">Mark handled emails as read</label></div>
                <div class="form-check"><input asp-for="Input.MarkTeamsAsRead" class="form-check-input" /><label asp-for="Input.MarkTeamsAsRead" class="form-check-label">Mark Teams chat as read when handled</label></div>
                <div class="form-text">Only messages actually forwarded/replied to. Skipped and dry-run messages stay unread.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.PollIntervalSeconds" class="form-label">Poll every (seconds)</label>
                <input asp-for="Input.PollIntervalSeconds" class="form-control" />
                <span asp-validation-for="Input.PollIntervalSeconds" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.OutlookCategory" class="form-label">Outlook category tag</label>
                <input asp-for="Input.OutlookCategory" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.HandledFolder" class="form-label">Move handled emails to folder</label>
                <input asp-for="Input.HandledFolder" class="form-control" placeholder="AI-Routed" />
                <div class="form-text">Use <code>/</code> for subfolders. Created if missing. Empty = leave in Inbox. A rule can override it.</div>
            </div>
            <div class="col-12">
                <label asp-for="Input.RedirectNotice" class="form-label">Redirect notice (added to replies when the message is forwarded)</label>
                <textarea asp-for="Input.RedirectNotice" class="form-control" rows="7"></textarea>
                <div class="form-text">
                    Tells the sender the message was only forwarded by the assistant, is marked as handled, and that you won't act on it outside the proper channel.
                    Placeholders: <code>{ForwardTo}</code>, <code>{SenderName}</code>. With "Personalise the reply with AI" on a rule, Claude keeps it but writes it only in the sender's language.
                    Empty = no notice.
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Input.ForwardNotice" class="form-label">Forward notice (placed above the forwarded message)</label>
                <textarea asp-for="Input.ForwardNotice" class="form-control" rows="10"></textarea>
                <div class="form-text">
                    Explains to the receiving team that this is an automated forward. Placeholders: <code>{Owner}</code> (your name), <code>{SenderName}</code>, <code>{SenderEmail}</code>,
                    <code>{RuleName}</code>, <code>{Subject}</code>, <code>{Summary}</code> (AI summary; lines with it are removed when there is none).
                    When AI is enabled, Claude writes it only once, in the language of the incoming message.
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Input.ReplyFooter" class="form-label">Footer appended to every reply</label>
                <textarea asp-for="Input.ReplyFooter" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12 small text-muted">
                Watermarks: email @(Model.Input.EmailWatermark?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "not started"),
                Teams @(Model.Input.TeamsWatermark?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "not started").
                Only messages received after the first run are processed.
            </div>
        </div>
        <div class="card-footer"><button class="btn btn-primary">Save</button></div>
    </div>
</form>
