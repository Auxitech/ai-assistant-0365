@page
@model MailRouter.Web.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Rules";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Routing rules</h2>
    <a asp-page="Edit" class="btn btn-primary">+ New rule</a>
</div>
<p class="text-muted small">
    Rules are matched on the sender address. Lowest priority number wins; on a tie, an exact email beats a domain, and a longer domain beats a shorter one
    (<code>it.cdb1.ch</code> beats <code>cdb1.ch</code>). A domain rule also matches subdomains. Put <strong>Ignore</strong> rules for your manager or your team
    at a low priority number so they are never redirected.
</p>

<table class="table table-sm align-middle">
    <thead><tr><th>Prio</th><th>Name</th><th>Match</th><th>Channels</th><th>Action</th><th>Forward to</th><th>AI</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rules)
    {
        <tr class="@(r.Enabled ? "" : "text-muted")">
            <td>@r.Priority</td>
            <td><a asp-page="Edit" asp-route-id="@r.Id">@r.Name</a></td>
            <td>
                <span class="badge bg-light text-dark">@r.MatchType</span> <code>@(r.MatchType == RuleMatchType.CatchAll ? "*" : r.Pattern)</code>
                @if (!string.IsNullOrWhiteSpace(r.Exceptions))
                {
                    <div class="small text-muted">except: @string.Join(", ", MailRouter.Web.Services.RuleMatcher.ParseList(r.Exceptions))</div>
                }
            </td>
            <td>@r.Channels</td>
            <td>@r.Action</td>
            <td class="small">
                @r.ForwardTo
                @if (r.Channels.HasFlag(ChannelFlags.Calls) && !string.IsNullOrEmpty(r.RedirectPhoneNumber)) { <div>📞 @r.RedirectPhoneNumber</div> }
            </td>
            <td class="small">@(r.RequireSupportRequest ? "triage" : "") @(r.UseAiReply ? "· reply" : "")</td>
            <td class="text-end text-nowrap">
                <form method="post" class="d-inline" asp-page-handler="Toggle" asp-route-id="@r.Id">
                    <button class="btn btn-sm btn-outline-secondary">@(r.Enabled ? "Disable" : "Enable")</button>
                </form>
                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@r.Id" onsubmit="return confirm('Delete rule @r.Name?')">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Rules.Count == 0)
    {
        <tr><td colspan="8" class="text-center text-muted py-4">No rules yet. Example: Domain <code>cdb1.ch</code> → Reply &amp; forward to <code>support@cdb1.ch</code>.</td></tr>
    }
    </tbody>
</table>

<div class="card mt-4">
    <div class="card-header">Test a sender</div>
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-5"><input asp-for="TestAddress" class="form-control" placeholder="someone@cdb1.ch, or +41211234567 for a call" /></div>
            <div class="col-md-3"><select asp-for="TestSource" class="form-select" asp-items="Html.GetEnumSelectList<MessageSource>()"></select></div>
            <div class="col-md-2"><button class="btn btn-outline-primary w-100">Test</button></div>
        </form>
        @if (Model.Tested)
        {
            @foreach (var x in Model.TestExcludedBy)
            {
                <div class="mt-3 text-muted">Skipped by exception in <a asp-page="Edit" asp-route-id="@x.Id">@x.Name</a></div>
            }
            <div class="mt-3">
                @if (Model.TestResult == null)
                {
                    <span class="text-muted">No rule matches — @(Model.TestSource == MessageSource.Call ? "the call would go to the fallback number from Settings, or be declined." : "the message would be logged and skipped.")</span>
                }
                else if (Model.TestSource == MessageSource.Call)
                {
                    var r = Model.TestResult;
                    <span>Matches <a asp-page="Edit" asp-route-id="@r.Id"><strong>@r.Name</strong></a> →
                        @if (r.Action == RuleAction.Ignore || string.IsNullOrEmpty(r.RedirectPhoneNumber)) { <strong>fallback number / declined</strong> }
                        else { <strong>transfer to @r.RedirectPhoneNumber</strong> <span class="text-muted">(@r.CallAnnouncement)</span> }
                    </span>
                }
                else
                {
                    <span>Matches <a asp-page="Edit" asp-route-id="@Model.TestResult.Id"><strong>@Model.TestResult.Name</strong></a>
                        → <strong>@Model.TestResult.Action</strong>@(string.IsNullOrEmpty(Model.TestResult.ForwardTo) ? "" : $" to {Model.TestResult.ForwardTo}")</span>
                }
            </div>
        }
    </div>
</div>
