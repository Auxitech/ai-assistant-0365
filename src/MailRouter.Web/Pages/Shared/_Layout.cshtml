<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mail Router</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">📨 Mail Router</a>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Activity</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Rules/Index">Rules</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Settings">Settings</a></li>
                </ul>
                <form method="post" asp-page="/Login" asp-page-handler="Logout" class="d-flex">
                    <button class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            </div>
        </nav>
    }
    <div class="container">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-info alert-dismissible">@flash<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
