# Copy to .env and fill in. Never commit .env.

# Password for the web dashboard
ADMIN__PASSWORD=change-me

# Entra ID app registration (see README)
GRAPH__CLIENTID=00000000-0000-0000-0000-000000000000
GRAPH__TENANTID=yourcompany.onmicrosoft.com

# Claude (optional: without it, rules still work and template replies are sent as-is)
ANTHROPIC_API_KEY=
ANTHROPIC__MODEL=claude-opus-5-5

# Teams calling bot (optional, see README "Teams calls"). Uses the GRAPH__ app registration above;
# add a client secret to it. Leave the secret empty to disable call handling.
CALLING__APPSECRET=
CALLING__PUBLICBASEURL=https://mailrouter.auxitech.ch
